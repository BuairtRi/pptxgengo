                {
                  "title": "Why now",
                  "body": [
                    {
                      "p": "Patients wait 11 days for a new appointment and hold times average eight minutes."
                    },
                    {
                      "p": "Three schedule systems cannot share open slots."
                    },
                    {
                      "p": "Staff lose time moving between screens."
                    }
                  ]
                },
                {
                  "title": "What changes",
                  "body": [
                    {
                      "p": "One platform, one booking workflow, one set of rules for all nine sites."
                    },
                    {
                      "p": "Your manager shows you the steps before go-live."
                    },
                    {
                      "p": "Patient care itself does not change."
                    }
                  ]
                },
                {
                  "title": "How we help",
                  "body": [
                    {
                      "p": "Role-based training, a champion on every floor and extra help for four weeks after launch."
                    },
                    {
                      "p": "Questions go to your floor-walker first."
                    }
                  ]
                }
              ]

    },
    {
      "name": "node01.label",
      "source_pointer": "/body/0/label",
      "kind": "string",
      "synthetic_source_example": "Corporate controllers"
    },
    {
      "name": "node01.title",
      "source_pointer": "/body/0/title",
      "kind": "string",
      "synthetic_source_example": "Review earlier"
    },
    {
      "name": "node02.text",
      "source_pointer": "/body/1/text",
      "kind": "string",
      "synthetic_source_example": "Controllers move from a single review on day nine to rolling review from day one. They see exceptions, not every entry, and sign off on day five."
    },
    {
      "name": "node03.text",
      "source_pointer": "/body/2/text",
      "kind": "string",
      "synthetic_source_example": "Time shifts from checking entries to judging exceptions."
    },
    {
      "name": "node04.label",
      "source_pointer": "/body/3/label",
      "kind": "string",
      "synthetic_source_example": "Entity accountants"
    },
    {
      "name": "node04.title",
      "source_pointer": "/body/3/title",
      "kind": "string",
      "synthetic_source_example": "Reconcile as you go"
    },
    {
      "name": "node05.text",
      "source_pointer": "/body/4/text",
      "kind": "string",
      "synthetic_source_example": "Accountants reconcile balance-sheet accounts during the month with one template. Exceptions go to an owner the same day, with the evidence attached."
    },
    {
      "name": "node06.text",
      "source_pointer": "/body/5/text",
      "kind": "string",
      "synthetic_source_example": "Month-end becomes a review of work already done."
    },
    {
      "name": "node07.label",
      "source_pointer": "/body/6/label",
      "kind": "string",
      "synthetic_source_example": "Shared services"
    },
    {
      "name": "node07.title",
      "source_pointer": "/body/6/title",
      "kind": "string",
      "synthetic_source_example": "Automate the matching"
    },
    {
      "name": "node08.text",
      "source_pointer": "/body/7/text",
      "kind": "string",
      "synthetic_source_example": "The shared-service team runs intercompany matching overnight and clears breaks each morning, replacing email threads across eleven entities."
    },
    {
      "name": "node09.text",
      "source_pointer": "/body/8/text",
      "kind": "string",

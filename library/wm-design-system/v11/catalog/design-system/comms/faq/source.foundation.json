                "titleInk": "emphasis"
              },
              "items": [
                {
                  "title": "Will I lose my job?",
                  "inlineNumber": "01",
                  "body": [
                    {
                      "p": "No roles are eliminated. Some tasks move; the role cards show which."
                    },
                    {
                      "label": "Where to look"
                    },
                    {
                      "p": "Role cards on the intranet"
                    }
                  ]
                },
                {
                  "title": "When is my training?",
                  "inlineNumber": "02",
                  "body": [
                    {
                      "p": "Eight hours in the four weeks before your site goes live, scheduled by your manager."
                    },
                    {
                      "label": "Where to look"
                    },
                    {
                      "p": "Your manager's schedule email"
                    }
                  ]
                },
                {
                  "title": "If the system is down?",
                  "inlineNumber": "03",
                  "body": [
                    {
                      "p": "A paper downtime kit and a hotline run for the first two weeks."
                    },
                    {
                      "label": "Where to look"
                    },
                    {
                      "p": "Downtime kit at every desk"
                    }
                  ]
                }
              ]
            },
            "source_pointer": "/body/0"
          }
        },

                {
                  "title": "Who do I call?",
                  "inlineNumber": "04",
                  "body": [
                    {
                      "p": "Your floor-walker first, then the service desk hotline."
                    },
                    {
                      "label": "Where to look"
                    },
                    {
                      "p": "Number on the huddle card"
                    }
                  ]
                },
                {
                  "title": "Keep my old templates?",
                  "inlineNumber": "05",
                  "body": [
                    {
                      "p": "Templates are rebuilt once by each clinic; your lead signs off."
                    },
                    {
                      "label": "Where to look"
                    },
                    {
                      "p": "Template sign-off sheet"
                    }
                  ]
                },
                {
                  "title": "How will patients know?",
                  "inlineNumber": "06",
                  "body": [
                    {
                      "p": "Email, text and lobby signs begin four weeks before your site goes live."
                    },
                    {
                      "label": "Where to look"
                    },
                    {
                      "p": "Lobby signs and website"
                    }
                  ]
                }
              ]
            },
            "source_pointer": "/body/1"

    },
    "body": {
      "y": [
        126,
        "bodyBottom"
      ]
    }
  },
  "chrome": [
    {
      "id": "logo",
      "spec": "Bottom-left, 12 pt tall; positive on light, reverse on dark; in the rail when a left panel is present."
    },
    {
      "id": "page",
      "spec": "Bottom-right, Mono 7 semibold; in the rail when a right panel is present. noPage drops it (covers only); the legal line cannot be dropped."
    },
    {
      "id": "legal",
      "spec": "Required on every slide, including covers, dividers and closing slides. {year} is the current year. Mono 7, right-aligned before the page number; may wrap to two lines next to a rail.",
      "required": true,
      "text": "© {year} West Monroe Partners | Reproduction and/or distribution without West Monroe Partners’ prior consent is prohibited."
    },
    {
      "id": "whiteboard",
      "required": true,
      "spec": "Required on every slide. 3 pt dots at the 18 pt lattice. Default is the header patch: 198 × 162 from (21, 18), or from x 291 beside a left panel and x 57 beside the nav rail, fading out to the right and bottom, behind the eyebrow and title; it always lands on the White area, never on a rail. Covers and dividers replace it with fields that frame the photo or fill the white side of the slide. Surface rule: on content slides the grid goes on White only (not on rails, tint panels, cards or photos), in Medium Gray. The one exception is a dark slide (surface inverse or deep) or a field laid over a Grounded panel with on: inverse and above: true, where the frame draws the dots in Dark Gray.",
      "fields": {
        "x": "lattice x",
        "y": "lattice y",
        "w": "pt",
        "h": "pt",
        "fade": "corner | right | left | bottom | none",
        "above": "true draws the field over the body (dots on a Grounded panel laid over a photo)",
        "on": "surface whose dot ink to use (inverse for Dark Gray dots)"
      }
    },
    {
      "id": "client-logo",
      "spec": "Optional, after a Medium Gray hairline, no taller than the WM logo."
    },
    {
      "id": "date",
      "spec": "Optional, Mono 7."
    },
    {
      "id": "section",
      "spec": "Optional section label, Mono 7 caps."
    }
  ],
  "features": [
    {
      "id": "title-zone",
      "name": "Title zone",
      "spec": "One-line title: eyebrow y 36, title y 54–90, rule y 108, body from 126. Two-line title (titleLines 2): rule y 144, body from 162. Most titles take one or two lines. titleLines 3 (rule 180, body 198) and titleLines 4 (rule 216, body 234) are for statement-length titles on slides whose job is the statement; they cost body height, so prefer a shorter title. Appendix density: heading-size title, rule 90, body 108. In a split frame the short column sets its own rules (see Split frames).",
      "geometry": {
        "oneLine": {
          "rule": 108,
          "bodyTop": 126
        },
        "twoLine": {
          "rule": 144,
          "bodyTop": 162
        },
        "appendix": {
          "title": "heading",
          "rule": 90,
          "bodyTop": 108
        },
        "threeLine": {
          "rule": 180,
          "bodyTop": 198
        },
        "fourLine": {
          "rule": 216,
          "bodyTop": 234
        }
      }
    },
    {
      "id": "zone.source",
      "name": "Source zone",
      "spec": "Directly above the footer, in the source style (Sans 9/12, secondary ink). Line 1 holds numbered notes, line 2 the source. One line: y 459–471 (compact), 465–477 (tall) or 477–489 (slim). Two lines: 12 pt higher. A source line wider than its column (measured at 9 pt) wraps onto a second line and counts as two lines; this mostly happens in the 270 pt short column of a split frame. Body bottom by footer and source lines: compact 468 / 450 / 432, tall 450 / 450 / 432, slim 486 / 468 / 450 (no source / one line / two lines). More than two lines belongs in an appendix or the speaker notes.",
      "geometry": {
        "compact": {
          "bottom": 471
        },
        "tall": {
          "bottom": 477
        },
        "lineHeight": 12,
        "bodyBottom": {
          "1": 450,
          "2": 432
        },
        "maxLines": 2,
        "slim": {
          "bottom": 489
        },
        "bodyBottomTable": {
          "compact": [
            468,
            450,
            432
          ],
          "tall": [
            450,
            450,
            432
          ],
          "slim": [
            486,
            468,
            450
          ]
        }
      }
    },
    {
      "id": "mark.footnote",
      "name": "Footnote markers",
      "spec": "Superscript numerals at 0.6 em, semibold, in emphasis ink, written [^1] in any text. Notes appear in the source zone as '¹ Note text'. Numbering restarts on every slide and follows reading order."
    },
    {
      "id": "stamp",
      "name": "Stamps",
      "spec": "An outlined Mono label, 18 pt tall, right-aligned to the main area at the eyebrow line (y 33). Text: 'Draft for discussion', 'Confidential', 'Preliminary' or 'For internal use'. Grounded on light, White on dark. One stamp per slide.",
      "values": [
        "Draft for discussion",
        "Confidential",
        "Preliminary",
        "For internal use"
      ]
    },
    {
      "id": "density",
      "name": "Density modes",
      "spec": "Two independent settings. Typography density (tokens.json density): density on the slide sets the body and headerDensity sets the eyebrow and title, each comfortable (default, today's standard), compact or dense; only type sizes and leading change, never geometry. Appendix (density: \"appendix\") is the older reference-slide mode: body and table text 12/18, table rows 28, compact header (heading-size title, rule y 90, body from 108); keep it for existing appendix slides.",
      "modes": {
        "comfortable": {
          "body": "body",
          "rowH": 36,
          "header": "standard"
        },
        "compact": {
          "note": "type steps down per tokens.density; geometry unchanged"
        },
        "dense": {
          "note": "type steps down further; floor 8 pt"
        },
        "appendix": {
          "body": "small",
          "rowH": 28,
          "header": "compact"
        }
      }
    }
  ],

{
  "schema": "wmds.frames.v0",
  "units": "pt",
  "summary": "Frames are the slide master and layouts: chrome and zones, no content. Two independent choices make a frame: rail (none, nav, left panel, right panel) and footer (compact, tall, slim), so 4 × 3 = 12 frames; split frames add four tall-column layouts on no rail or the nav rail. Panel rails run full height; the footer band and rule fill only the non-rail width. Logo stays bottom-left and page number bottom-right, in the ink of the surface under them.",
  "pptx": "Slide master holds the chrome (logo, legal line, page number placeholders). Each frame is a slide layout with named placeholder zones (header, body, rail, source).",
  "rails": {
    "none": {
      "main": [
        57,
        903
      ],
      "note": "Main x 57–903, the full 12-column content width."
    },
    "nav": {
      "main": [
        57,
        903
      ],
      "tabs": {
        "x": 21,
        "width": 18,
        "gap": 6,
        "widths": [
          18,
          24
        ]
      },
      "note": "Section tabs at x 21–39 are slots: nav {items: 2–6 short section names, active: index}. The active tab is Grounded with White text, the others Light Gray with Dark Gray text. Content area unchanged (x 57–903)."
    },
    "left": {
      "panel": [
        0,
        273
      ],
      "railContent": [
        57,
        255
      ],
      "main": [
        345,
        903
      ],
      "surfaces": [
        "inverse",
        "deep",
        "subtle"
      ],
      "note": "Panel x 0–273 (railSurface inverse, deep or subtle), rail content x 57–255, main x 345–903. The WM logo sits in the rail; the header dot patch starts at x 291."
    },
    "right": {
      "panel": [
        687,
        960
      ],
      "railContent": [
        705,
        903
      ],
      "main": [
        57,
        615
      ],
      "surfaces": [
        "inverse",
        "deep",
        "subtle"
      ],
      "note": "Panel x 687–960 (railSurface inverse, deep or subtle), rail content x 705–903, main x 57–615. The page number sits in the rail."
    }
  },
  "footers": {
    "compact": {
      "rule": 477,
      "row": [
        486,
        504
      ],
      "bodyBottom": 468,
      "note": "Hairline rule at y 477 across the main width, logo, legal line and page number on y 486–504; body to 468."

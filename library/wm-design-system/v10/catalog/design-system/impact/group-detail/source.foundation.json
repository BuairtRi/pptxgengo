                  "title": "Process",
                  "label": "High impact",
                  "body": [
                    {
                      "p": "Walk-in and phone booking merge into one scheduling workflow with new double-booking rules."
                    },
                    {
                      "p": "Support: Redesign sessions with five clinics."
                    }
                  ]
                },
                {
                  "title": "Technology",
                  "label": "High impact",
                  "body": [
                    {
                      "p": "Three legacy schedule screens are replaced by a single web platform with new login."
                    },
                    {
                      "p": "Support: Sandbox practice from week 6."
                    }
                  ]
                },
                {
                  "title": "Role",
                  "label": "High impact",
                  "body": [
                    {
                      "p": "Schedulers own referral holds and waitlist outreach that used to sit with nurses."
                    },
                    {
                      "p": "Support: Updated role cards and job aids."
                    }
                  ]
                },
                {
                  "title": "Skills",
                  "label": "Medium impact",
                  "body": [
                    {
                      "p": "Template building and rules-based overbooking are new skills for the team."
                    },
                    {
                      "p": "Support: Eight hours of role-based training."
                    }
                  ]
                }
              ]

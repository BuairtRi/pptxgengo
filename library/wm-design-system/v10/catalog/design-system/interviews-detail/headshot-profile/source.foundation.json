                {
                  "title": "Denials start at authorization",
                  "text": "40% of denials trace to missing authorizations. So what: fix intake before appeals."
                },
                {
                  "title": "Errors surface at billing",
                  "text": "Front-desk errors are found about three weeks after the visit. So what: add a check-in step."
                },
                {
                  "title": "Three work queues, no single view",
                  "text": "Teams hide backlog in separate queues and hand-built reports. So what: one queue by payer."
                },
                {
                  "title": "Appeals depend on two analysts",
                  "text": "Appeals average 45 days and the know-how sits with two people. So what: cross-train now."
                }
              ]
            },
            "source_pointer": "/body/10"
          }
        }

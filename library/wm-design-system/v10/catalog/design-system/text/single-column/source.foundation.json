              "x": 57,
              "y": 126,
              "w": 558,
              "text": "The controller's first morning"
            },
            "source_pointer": "/body/0"
          }
        },
        {
          "id": "node02",
          "kind": "scene",
          "rect": {
            "x_pt": 0,
            "y_pt": 0,
            "width_pt": 0,
            "height_pt": 0
          },
          "scene": {
            "node": {
              "type": "text",
              "style": "body",
              "ink": "primary",
              "x": 57,
              "y": 162,
              "w": 558,
              "text": "On day one the controller opens a single exceptions queue instead of a stack of spreadsheets. Each item shows the account, the amount, the likely cause and the person who owns the fix."
            },
            "source_pointer": "/body/1"
          }
        },
        {
          "id": "node03",
          "kind": "scene",
          "rect": {
            "x_pt": 0,
            "y_pt": 0,
            "width_pt": 0,
            "height_pt": 0
          },
          "scene": {
            "node": {
              "type": "text",
              "style": "body",
              "ink": "primary",
              "x": 57,
              "y": 246,
              "w": 558,
              "text": "By the end of day two most items are cleared by the entity accountants. What remains are judgment calls: a reserve, a reclassification, a timing question. Those are the items a controller should spend time on."
            },
            "source_pointer": "/body/2"
          }
        },
        {
          "id": "node04",
          "kind": "scene",
          "rect": {
            "x_pt": 0,
            "y_pt": 0,
            "width_pt": 0,
            "height_pt": 0
          },
          "scene": {
            "node": {
              "type": "text",
              "style": "body",
              "ink": "primary",
              "x": 57,
              "y": 330,
              "w": 558,
              "text": "Nothing waits for the end of the month to be looked at, so nothing arrives all at once."
            },
            "source_pointer": "/body/3"
          }
        },
        {
          "id": "node05",
          "kind": "scene",

          "scene": {
            "node": {
              "type": "vstepper",
              "x": 345,
              "y": 36,
              "w": 558,
              "steps": [
                {
                  "label": "Rung 1",
                  "title": "Open",
                  "text": "“Walk me through the last time a patient asked what a visit would cost.” Intent: get the real story, not the policy. Move on when you hear a named step.",
                  "state": "current"
                },
                {
                  "label": "Rung 2",
                  "title": "Probe",
                  "text": "“What happened next, and who did you hand it to?” Intent: trace handoffs and waiting time. Move on when each wait has an owner.",
                  "state": "next"
                },
                {
                  "label": "Rung 3",
                  "title": "Challenge",
                  "text": "“If the estimate came before booking, what would break?” Intent: test assumptions and find the true constraint. Move on when the constraint is named.",
                  "state": "next"
                },
                {
                  "label": "Rung 4",
                  "title": "Confirm",
                  "text": "“So the blocker is missing charge data. Is that right, and who owns it?” Intent: check we heard it and agree an owner. Move on when the table says yes.",
                  "state": "next"
                }
              ]
            },
            "source_pointer": "/body/0"
          }

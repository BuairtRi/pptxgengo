              "items": [
                {
                  "title": "Denials start at authorization",
                  "text": "40% of denials trace to missing authorizations. So what: fix intake first."
                },
                {
                  "title": "Errors surface at billing",
                  "text": "Front-desk errors are found three weeks late. So what: add check-in checks."
                },
                {
                  "title": "Three queues, no shared view",
                  "text": "Teams work denials in separate queues. So what: build one queue by payer."
                },
                {
                  "title": "Appeals average 45 days",
                  "text": "Two analysts hold the appeal know-how. So what: cross-train and staff the tail."
                },
                {
                  "title": "Reports are hand-built",
                  "text": "Monthly reports restart in spreadsheets. So what: automate the denial extract."
                }
              ]
            },
            "source_pointer": "/body/8"

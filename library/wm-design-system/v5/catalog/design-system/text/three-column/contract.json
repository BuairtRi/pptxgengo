      "source_pointer": "/body/6/label",
      "kind": "string",
      "synthetic_source_example": "Shared services"
    },
    {
      "name": "node07.title",
      "source_pointer": "/body/6/title",
      "kind": "string",
      "synthetic_source_example": "Automate the matching"

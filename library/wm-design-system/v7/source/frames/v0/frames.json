    }
  },
  "chrome": [
    {
      "id": "logo",
      "spec": "Bottom-left, 12 pt tall; positive on light, reverse on dark; in the rail when a left panel is present."
    },
    {
      "id": "page",
      "spec": "Bottom-right, Mono 7 semibold; in the rail when a right panel is present."
    },
    {
      "id": "legal",
      "spec": "Required on every slide, including covers, dividers and closing slides. {year} is the current year. Mono 7, right-aligned before the page number; may wrap to two lines next to a rail.",
      "required": true,
      "text": "© {year} West Monroe Partners | Reproduction and/or distribution without West Monroe Partners’ prior consent is prohibited."
    },
    {
      "id": "whiteboard",
      "required": true,
      "spec": "Required on every slide. 3 pt dots at the 18 pt lattice. Default is the header patch: 198 × 162 from (21, 18), or from x 291 beside a left panel and x 57 beside the nav rail, fading out to the right and bottom, behind the eyebrow and title. Covers and dividers replace it with fields that frame the photo or fill the white side of the slide. Dots are Medium Gray on White and the light grays, Dark Gray on Grounded and Deep.",
      "fields": {
        "x": "lattice x",
        "y": "lattice y",
        "w": "pt",
        "h": "pt",
        "fade": "corner | right | left | bottom | none"
      }
    },
    {
      "id": "client-logo",
      "spec": "Optional, after a Medium Gray hairline, no taller than the WM logo."
    },
    {
      "id": "date",
      "spec": "Optional, Mono 7."
    },
    {
      "id": "section",
      "spec": "Optional section label, Mono 7 caps."
    }
  ],
  "features": [
    {
      "id": "title-zone",
      "name": "Title zone",
      "spec": "One-line title: eyebrow y 36, title y 54–90, rule y 108, body from 126. Two-line title: title y 54–126, rule y 144, body from 162. Titles never exceed two lines.",
      "geometry": {
        "oneLine": {
          "rule": 108,
          "bodyTop": 126
        },
        "twoLine": {
          "rule": 144,
          "bodyTop": 162
        },
        "appendix": {
          "title": "heading",
          "rule": 90,
          "bodyTop": 108
        }
      }
    },
    {
      "id": "zone.source",
      "name": "Source zone",
      "spec": "Directly above the footer, in the source style (Sans 9/12, secondary ink). Line 1 holds numbered notes, line 2 the source. One line: y 459–471 (compact) or 465–477 (tall), body ends at 450. Two lines: y 447–471 or 453–477, body ends at 432. More than two lines belongs in an appendix or the speaker notes.",
      "geometry": {
        "compact": {
          "bottom": 471
        },
        "tall": {
          "bottom": 477
        },
        "lineHeight": 12,
        "bodyBottom": {
          "1": 450,
          "2": 432
        },
        "maxLines": 2,
        "slim": {
          "bottom": 489
        }
      }
    },
    {
      "id": "mark.footnote",
      "name": "Footnote markers",
      "spec": "Superscript numerals at 0.6 em, semibold, in emphasis ink, written [^1] in any text. Notes appear in the source zone as '¹ Note text'. Numbering restarts on every slide and follows reading order."
    },
    {
      "id": "stamp",
      "name": "Stamps",
      "spec": "An outlined Mono label, 18 pt tall, right-aligned to the main area at the eyebrow line (y 33). Text: 'Draft for discussion', 'Confidential', 'Preliminary' or 'For internal use'. Grounded on light, White on dark. One stamp per slide.",
      "values": [
        "Draft for discussion",
        "Confidential",
        "Preliminary",
        "For internal use"
      ]
    },
    {
      "id": "density",
      "name": "Density modes",
      "spec": "Standard: body 14/21, table rows 36, standard header. Appendix: body and table text 12/18, table rows 28, compact header (heading-size title, rule y 90, body from 108). Appendix is chosen explicitly for reference slides; it is never applied automatically to make content fit.",
      "modes": {
        "standard": {
          "body": "body",
          "rowH": 36,
          "header": "standard"
        },
        "appendix": {
          "body": "small",
          "rowH": 28,
          "header": "compact"
        }
      }
    }
  ],

{
  "schema": "wmds.frames.v0",
  "units": "pt",
  "summary": "Frames are the slide master and layouts: chrome and zones, no content. Two independent choices make a frame: rail (none, nav, left panel, right panel) and footer (compact, tall). Panel rails run full height; the footer band and rule fill only the non-rail width. Logo stays bottom-left and page number bottom-right, in the ink of the surface under them.",
  "pptx": "Slide master holds the chrome (logo, legal line, page number placeholders). Each frame is a slide layout with named placeholder zones (header, body, rail, source).",
  "rails": {
    "none": {
      "main": [
        57,
        903
      ]
    },
    "nav": {
      "main": [
        57,
        903
      ],
      "tabs": {
        "x": 21,
        "width": 18,
        "gap": 6,
        "widths": [

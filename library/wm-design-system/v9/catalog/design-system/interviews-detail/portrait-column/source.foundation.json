              "items": [
                {
                  "title": "Denials start at authorization",
                  "text": "Evidence: 40% of denials trace to authorization gaps. Implication: fix intake, not appeals."
                },
                {
                  "title": "Errors surface late",
                  "text": "Evidence: front-desk errors found at billing, three weeks on. Implication: add a check-in eligibility step."
                },
                {
                  "title": "No single work view",
                  "text": "Evidence: three queues, reports rebuilt by hand monthly. Implication: one queue by payer."
                },
                {
                  "title": "Appeal know-how is concentrated",
                  "text": "Evidence: two analysts hold the practice behind 45-day appeals. Implication: cross-train first."
                },
                {
                  "title": "Payer contracts have no owner",
                  "text": "Evidence: nobody could name one owner. Implication: assign an owner before redesign."
                }
              ]
            },
            "source_pointer": "/body/10"
          }
        },

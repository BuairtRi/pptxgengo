  "slots": [
    {
      "name": "eyebrow",
      "source_pointer": "/eyebrow",
      "kind": "string",
      "synthetic_source_example": "Modernization economics"
    },
    {
      "name": "title",
      "source_pointer": "/title",
      "kind": "string",
      "synthetic_source_example": "The script has [[flipped]] on legacy systems"
    },
    {
      "name": "node01.text",
      "source_pointer": "/body/0/text",
      "kind": "string",
      "synthetic_source_example": "AI is cutting the time and cost of complex modernization by changing how teams analyze, design, build and test."
    },
    {
      "name": "node02.text",
      "source_pointer": "/body/1/text",
      "kind": "string",
      "synthetic_source_example": "How are legacy systems holding your business back?"
    },
    {
      "name": "node03.text",
      "source_pointer": "/body/2/text",
      "kind": "string",
      "synthetic_source_example": "If it cost one-tenth of what you expect, what would that unlock?"
    },
    {
      "name": "node04.body.item01.p",
      "source_pointer": "/body/3/body/0/p",
      "kind": "string",
      "synthetic_source_example": "Map data, interfaces and controls to see which systems block AI-enabled work."
    },
    {
      "name": "node04.label",
      "source_pointer": "/body/3/label",
      "kind": "string",
      "synthetic_source_example": "AI-native readiness"
    },
    {
      "name": "node04.title",
      "source_pointer": "/body/3/title",
      "kind": "string",
      "synthetic_source_example": "How can you get your business ready to run on AI?"
    },
    {
      "name": "node05.body.item01.p",
      "source_pointer": "/body/4/body/0/p",
      "kind": "string",
      "synthetic_source_example": "Modular platforms let teams ship weekly instead of waiting on quarterly releases."
    },
    {
      "name": "node05.label",
      "source_pointer": "/body/4/label",
      "kind": "string",
      "synthetic_source_example": "Growth velocity"
    },
    {
      "name": "node05.title",
      "source_pointer": "/body/4/title",
      "kind": "string",
      "synthetic_source_example": "What products could you launch without release-cycle delays?"
    },
    {
      "name": "node06.body.item01.p",
      "source_pointer": "/body/5/body/0/p",
      "kind": "string",
      "synthetic_source_example": "Fewer handoffs and less rework free capacity that today goes to keeping old systems running."
    },
    {
      "name": "node06.label",

{
  "schema": "pptxgengo.compose-spec.v1",
  "slides": [
    {
      "id": "font-families",
      "title": "IBM Plex Sans: editable, measured typography",
      "width_pt": 960,
      "height_pt": 540,
      "title_bounds": {
        "x": 40,
        "y": 35,
        "width": 880,
        "height": 55
      },
      "title_font_face": "IBM Plex Sans",

          "font_size_pt": 16,
          "foreground": "#070154",
          "align": "left",
          "valign": "top"
        },
        {
          "id": "plex-wrap",
          "kind": "text",
          "bounds": {
            "x": 40,
            "y": 195,
            "width": 400,
            "height": 100
          },
          "text": "The same words, point size and box width are measured independently for each font. PowerPoint determines the line breaks.",
          "font_face": "IBM Plex Sans",
          "font_size_pt": 16,
          "foreground": "#070154",
          "align": "left",
          "valign": "top"
        },
        {
          "id": "arial-wrap",
          "kind": "text",
          "bounds": {
            "x": 510,
            "y": 195,
            "width": 400,
            "height": 100
          },
          "text": "The same words, point size and box width are measured independently for each font. PowerPoint determines the line breaks.",
          "font_face": "Arial",
          "font_size_pt": 16,
          "foreground": "#070154",
          "align": "left",
          "valign": "top"
        }

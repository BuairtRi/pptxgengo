{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pptxgengo.local/proposal-narrative.v1.schema.json",
  "title": "pptxgengo proposal narrative",
  "type": "object",
  "required": ["schema", "brief", "slides"],
  "properties": {
    "schema": {"const": "pptxgengo.proposal-narrative.v1"},
    "brief": {
      "type": "object",
      "required": ["name", "synthetic", "date", "audience", "decision"],
      "properties": {
        "name": {"type": "string"}, "synthetic": {"type": "boolean"}, "date": {"type": "string"}, "audience": {"type": "string"}, "decision": {"type": "string"},
        "source_packet": {"type": "array", "items": {"$ref": "#/$defs/artifact"}}
      }
    },
    "slides": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "audience", "role", "takeaway", "assertion_title", "required_detail", "visual_relationship"], "properties": {"id": {"type": "string"}, "audience": {"type": "string"}, "role": {"type": "string"}, "takeaway": {"type": "string"}, "assertion_title": {"type": "string"}, "required_detail": {"type": "array", "items": {"type": "string"}}, "emphasis_targets": {"type": "array", "items": {"type": "string"}}, "visual_relationship": {"type": "string"}, "evidence_refs": {"type": "array", "items": {"type": "string"}}, "qualifications": {"type": "array", "items": {"type": "string"}}}}},
    "claims": {"type": "array", "items": {"type": "object", "required": ["id", "assertion", "status"], "properties": {"id": {"type": "string"}, "assertion": {"type": "string"}, "status": {"enum": ["supported", "hypothesis", "synthetic", "unverified"]}, "evidence_refs": {"type": "array", "items": {"type": "string"}}, "qualification": {"type": "string"}}}},
    "evidence": {"type": "array", "items": {"type": "object", "required": ["id", "source", "locator"], "properties": {"id": {"type": "string"}, "source": {"$ref": "#/$defs/artifact"}, "locator": {"type": "string"}, "quote": {"type": "string"}, "typed_extract": {"type": "string"}, "caveat": {"type": "string"}}}}
  },
  "$defs": {
    "artifact": {"type": "object", "required": ["path", "sha256"], "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "role": {"type": "string"}}}
  }
}

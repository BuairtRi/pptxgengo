{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "pptxgengo library assembly",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "slides"
  ],
  "properties": {
    "schema": {
      "const": "pptxgengo.library-assembly.v1"
    },
    "narrative_path": {
      "type": "string",
      "minLength": 1
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "contract_id",
          "values_path",
          "slide_id"
        ],
        "properties": {
          "contract_id": {
            "type": "string",
            "minLength": 1
          },
          "values_path": {
            "type": "string",
            "minLength": 1
          },
          "slide_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          }
        }
      }
    }
  }
}

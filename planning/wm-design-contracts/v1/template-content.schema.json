{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "year",
    "slides"
  ],
  "properties": {
    "schema": {
      "const": "pptxgengo.wmds-template-document.v1"
    },
    "year": {
      "type": "integer",
      "minimum": 2000,
      "maximum": 9999
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "template",
              "content_kind",
              "values"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]+$"
              },
              "template": {
                "const": "cards/3"
              },
              "content_kind": {
                "enum": [
                  "synthetic_example",
                  "supplied_content"
                ]
              },
              "values": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "eyebrow",
                  "title",
                  "cards"
                ],
                "properties": {
                  "eyebrow": {
                    "type": "string",
                    "minLength": 1
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1
                  },
                  "cards": {
                    "type": "array",
                    "minItems": 3,
                    "maxItems": 3,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "key",
                        "title",
                        "body"
                      ],
                      "properties": {
                        "key": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9_-]+$"
                        },
                        "title": {
                          "type": "string",
                          "minLength": 1
                        },
                        "body": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "template",
              "content_kind",
              "values"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]+$"
              },
              "template": {
                "const": "cards/4"
              },
              "content_kind": {
                "enum": [
                  "synthetic_example",
                  "supplied_content"
                ]
              },
              "values": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "eyebrow",
                  "title",
                  "cards"
                ],
                "properties": {
                  "eyebrow": {
                    "type": "string",
                    "minLength": 1
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1
                  },
                  "cards": {
                    "type": "array",
                    "minItems": 4,
                    "maxItems": 4,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "key",
                        "title",
                        "body"
                      ],
                      "properties": {
                        "key": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9_-]+$"
                        },
                        "title": {
                          "type": "string",
                          "minLength": 1
                        },
                        "body": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "template",
              "content_kind",
              "values"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]+$"
              },
              "template": {
                "const": "stats/four-metrics"
              },
              "content_kind": {
                "enum": [
                  "synthetic_example",
                  "supplied_content"
                ]
              },
              "values": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "eyebrow",
                  "title",
                  "metric1",
                  "metric2",
                  "metric3",
                  "metric4",
                  "support",
                  "source"
                ],
                "properties": {
                  "eyebrow": {
                    "type": "string",
                    "minLength": 1
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1
                  },
                  "metric1": {
                    "$ref": "#/$defs/metric"
                  },
                  "metric2": {
                    "$ref": "#/$defs/metric"
                  },
                  "metric3": {
                    "$ref": "#/$defs/metric"
                  },
                  "metric4": {
                    "$ref": "#/$defs/metric"
                  },
                  "support": {
                    "oneOf": [
                      {
                        "type": "string",
                        "minLength": 1
                      },
                      {
                        "$ref": "#/$defs/richtext"
                      }
                    ]
                  },
                  "source": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "template",
              "content_kind",
              "values"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]+$"
              },
              "template": {
                "const": "takeaway-rail/metrics-rail"
              },
              "content_kind": {
                "enum": [
                  "synthetic_example",
                  "supplied_content"
                ]
              },
              "values": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "eyebrow",
                  "title",
                  "metric1",
                  "metric2",
                  "support",
                  "source",
                  "railEyebrow",
                  "railHeading",
                  "railBody"
                ],
                "properties": {
                  "eyebrow": {
                    "type": "string",
                    "minLength": 1
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1
                  },
                  "metric1": {
                    "$ref": "#/$defs/metric"
                  },
                  "metric2": {
                    "$ref": "#/$defs/metric"
                  },
                  "support": {
                    "oneOf": [
                      {
                        "type": "string",
                        "minLength": 1
                      },
                      {
                        "$ref": "#/$defs/richtext"
                      }
                    ]
                  },
                  "source": {
                    "type": "string",
                    "minLength": 1
                  },
                  "railEyebrow": {
                    "type": "string",
                    "minLength": 1
                  },
                  "railHeading": {
                    "oneOf": [
                      {
                        "type": "string",
                        "minLength": 1
                      },
                      {
                        "$ref": "#/$defs/richtext"
                      }
                    ]
                  },
                  "railBody": {
                    "oneOf": [
                      {
                        "type": "string",
                        "minLength": 1
                      },
                      {
                        "$ref": "#/$defs/richtext"
                      }
                    ]
                  }
                }
              }
            }
          }
        ]
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pptxgengo:wmds-template-document:v1",
  "title": "Bound WMDS template content v1",
  "$defs": {
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label"
      ],
      "properties": {
        "value": {
          "type": "string",
          "minLength": 1
        },
        "format": {
          "$ref": "#/$defs/format"
        },
        "label": {
          "type": "string",
          "minLength": 1
        }
      },
      "oneOf": [
        {
          "required": [
            "value"
          ],
          "not": {
            "required": [
              "format"
            ]
          }
        },
        {
          "required": [
            "format"
          ],
          "not": {
            "required": [
              "value"
            ]
          }
        }
      ]
    },
    "format": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "kind"
      ],
      "properties": {
        "value": {
          "oneOf": [
            {
              "type": "number"
            },
            {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "number"
              }
            }
          ]
        },
        "kind": {
          "enum": [
            "currency",
            "percent",
            "number",
            "delta",
            "range"
          ]
        },
        "currency": {
          "enum": [
            "",
            "USD",
            "EUR",
            "GBP"
          ]
        },
        "scale": {
          "enum": [
            "",
            "K",
            "M",
            "B"
          ]
        },
        "unit": {
          "type": "string"
        },
        "of": {
          "enum": [
            "",
            "currency",
            "percent"
          ]
        }
      }
    },
    "richtext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "paragraphs"
      ],
      "properties": {
        "paragraphs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "key",
              "runs"
            ],
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]+$"
              },
              "runs": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "key",
                    "text"
                  ],
                  "properties": {
                    "key": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_-]+$"
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1
                    },
                    "weight": {
                      "enum": [
                        0,
                        400,
                        500,
                        600,
                        700
                      ]
                    },
                    "ink": {
                      "type": "string",
                      "$comment": "Empty or omitted ink inherits the source node role; nonempty roles are resolved and contrast-checked at runtime."
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "$comment": "Structural guidance for the closed Go API. Runtime also rejects duplicate member names, nonvisible text, duplicate identities/keys, unsupported markup, font/glyph/contrast failures, numeric envelope violations and fixed-slot overflow. Formatting semantic combinations are validated by FormatNumber."
}
